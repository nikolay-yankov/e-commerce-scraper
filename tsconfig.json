{
  "compilerOptions": {
    // Node 24 (V8 13.6) implements all of ES2025, so emit it as-is: no downlevelling.
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Explicit `import type`; keeps the code correct for single-file transpilers (tsx, vitest).
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
