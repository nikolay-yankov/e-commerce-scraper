{
  "name": "ecommerce-scraper",
  "version": "1.0.0",
  "description": "CLI that scrapes webscraper.io's static e-commerce test site into a single JSON report",
  "main": "./dist/cli.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/e2e.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ecommerce-scraper": "./dist/cli.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "p-limit": "^7.3.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
